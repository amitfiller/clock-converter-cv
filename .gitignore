# Cursor IDE — local config
.cursorrules
.cursor/

# Generated dataset files (keep dirs via .gitkeep)
data/raw/digital/*
!data/raw/digital/.gitkeep
data/raw/analog/*
!data/raw/analog/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/test_sample/*
!data/test_sample/.gitkeep

# Tracked explicitly: data/times_manifest.json, data/validation_sample.png

# Generated demo and debugging outputs (keep dirs via .gitkeep)
demo_outputs/**
!demo_outputs/
!demo_outputs/**/
!demo_outputs/**/.gitkeep

# Python
__pycache__/
*/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Python venv
venv/
.env/
.venv/
.env

# PyTorch checkpoints (ignore all; track only Module A best weights)
models/checkpoints/*.pth
models/checkpoints/*.pt
!models/checkpoints/digital_reader_best.pth

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
